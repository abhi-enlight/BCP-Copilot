[TEMPLATE]
# ==============================================================================
# n8n & BCP Assist AI Agent - Environment Configuration
# ==============================================================================

# --- General / Timezone ---
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# --- n8n Service Configuration ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_here

# --- Execution & Permissions ---
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
NODE_FUNCTION_ALLOW_BUILTIN=*
NODE_FUNCTION_ALLOW_EXTERNAL=*

# --- PostgreSQL Database (Local n8n storage) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=replace_with_secure_postgres_password

# --- Supabase (Knowledge Base & Vector Store) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Supabase (Frontend / Next.js — must be set for the web app) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- n8n Zoho Sync Webhooks (must match your n8n workflow webhook URLs) ---
N8N_ZOHO_SYNC_WEBHOOK=https://your-n8n-host/webhook/bcp-task-ingest-v2
N8N_ZOHO_TASK_UPDATE_WEBHOOK=https://your-n8n-host/webhook/bcp-task-update

# --- AI Model API Keys ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key_here
